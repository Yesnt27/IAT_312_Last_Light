    - character:
        name: Player
      text: A code... There's a safe up on the fourth floor. Maybe this opens it.
  setFlag: BottleDeciphered
  newTaskId: day3_open_safe
  newTaskText: '*Open the safe on the fourth floor (code: 2741)*'
