PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1565971589}
    m_Modifications:
    - target: {fileID: 1250385829456314142, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: m_text
      value: JOURNAL
      objectReference: {fileID: 0}
    - target: {fileID: 1250385829456314142, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: promptText
      value: Pick up the journal
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: afterFound.setFlag
      value: Journal
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: activeOnDays.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: 'activeOnDays.Array.data[0]'
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: foundDialogue.dialogueLines.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: foundDialogue.dialogueLines.Array.data[0].text
      value: '*You found a journal. Most of its pages have been torn out.*'
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: foundDialogue.dialogueLines.Array.data[1].text
      value: '*November 13th: First day on the island weird that they sent me out on my own...but the money is good.*'
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: foundDialogue.dialogueLines.Array.data[2].text
      value: '*This place has an eerie feeling I can''t explain. It''s probably nothing though*'
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: foundDialogue.dialogueLines.Array.data[3].text
      value: '*What I''ve noticed is that some of these ships coming by are...different. As if they don''t belong*'
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: foundDialogue.dialogueLines.Array.data[4].text
      value: '*The number of valves are a sign, normal ships have 2 valves but for some reason there were a few with 4..*'
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: foundDialogue.dialogueLines.Array.data[5].text
      value: This must be the old keepers journal. I wonder what happened to the other pages.
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: foundDialogue.dialogueLines.Array.data[1].character.name
      value: Journal
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: foundDialogue.dialogueLines.Array.data[2].character.name
      value: Journal
      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
