      objectReference: {fileID: 0}
    - target: {fileID: 4544230747063777731, guid: 136df4206f3102b45a38d9ca74ed5363, type: 3}
      propertyPath: foundDialogue.dialogueLines.Array.data[1].text
      value: '*[PLACEHOLDER] Entry 1: "Every night the keeper must climb to the top of the lighthouse, watch the ships that pass, and guide them correctly. Watch out for a black shadow on the ship...'
