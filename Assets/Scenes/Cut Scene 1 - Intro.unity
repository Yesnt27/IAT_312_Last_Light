  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryTrigger
  mode: 0
  activeOnDays: 
  activeDuringTasks: []
  requiredFlags: []
  hiddenByFlags: []
  rememberAsFlag: 
  dialogue:
    dialogueLines:
    - character:
        name: 
      text: '[PLACEHOLDER] *The small boat rocks over grey waves towards a lonely island.*'
    - character:
        name: Manager
      text: '[PLACEHOLDER] That''s it. Your lighthouse for the next few nights.'
    - character:
        name: Player
      text: '[PLACEHOLDER] Why me? I''ve never kept a light before.'
    - character:
        name: Manager
      text: '[PLACEHOLDER] The last keeper left in a hurry, and nobody else would take the job.'
    - character:
        name: Manager
      text: '[PLACEHOLDER] Keep the lamp burning, watch the ships that pass, and report anything strange.'
    - character:
        name: Player
      text: '[PLACEHOLDER] Anything strange?'
    - character:
        name: Manager
      text: '[PLACEHOLDER] You''ll know it when you see it. I''ll be back for you when it''s done.'
  outcome:
    newTaskId: 
    newTaskText: 
    setFlag: 
  endsCutscene: 1
  loadScene: Outside
  loadSpawnId: 
