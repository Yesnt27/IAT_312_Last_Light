    m_PersistentCalls:
      m_Calls: []
  dialogue:
    dialogueLines:
    - character:
        name: 
      text: '*A worn book full of strange symbols, each one paired with a letter.*'
    - character:
        name: 
      text: '*Matching them to the note, the message spells out a word: [PLACEHOLDER WORD]*'
    - character:
        name: Player
      text: What could this be used for?
  setFlag: BottleDeciphered
  newTaskId: day3_use_message
  newTaskText: '*Figure out what this message can be used for*'
