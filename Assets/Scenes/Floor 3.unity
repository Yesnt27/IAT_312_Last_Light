  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InteractDialogue
  promptText: Read the book of symbols
  activeOnDays: 
  activeDuringTasks: []
  requiredFlags:
  - BottleMessage
  hiddenByFlags:
  - BottleDeciphered
  unlockFlag: 
  lockedDialogue:
    dialogueLines: []
